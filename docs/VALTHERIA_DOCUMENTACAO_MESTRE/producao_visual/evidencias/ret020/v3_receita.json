 "comandos": [
  "export BLENDER_USER_RESOURCES=<pasta com a extensão MPFB2 e os assets MakeHuman ligados em mpfb/data>",
  "cd cliente-godot/ferramentas/v3",
  "python vestir_v3.py m <saida>/m        # P1 (opcional: V3_BLEND=<arquivo.blend> grava a fonte editável)",
  "python vestir_v3.py f <saida>/f        # P2 (gera também a trança LOD cabelo_lod)",
  "python espada_v3.py <saida>/espada      # P5: graus d, b, s + espada_longa.json (pegada e bainha de cintura)",
  "cd ../..",
  "PYTHONPATH=ferramentas/v3 python ferramentas/v3/ligar_pecas.py assets/chars/body_male_peasant.glb <saida>/m/mpfb_m.glb <saida>/lig_m '{\"pc_humano_m\":[\"corpo\",\"olhos\",\"sobrancelha\",\"cilios\"],\"rp_aldeao_tunica_m\":[\"tunica\"],\"rp_aldeao_calca_m\":[\"calca\"],\"rp_botas_couro_m\":[\"botas\"],\"ca_curto_01\":[\"cabelo\"]}'",
  "PYTHONPATH=ferramentas/v3 python ferramentas/v3/ligar_pecas.py assets/chars/body_female_peasant.glb <saida>/f/mpfb_f.glb <saida>/lig_f '{\"pc_humano_f\":[\"corpo\",\"olhos\",\"sobrancelha\",\"cilios\"],\"rp_aldeao_tunica_f\":[\"tunica\"],\"rp_aldeao_calca_f\":[\"calca\"],\"rp_botas_couro_f\":[\"botas\"],\"ca_tranca_longa\":[\"cabelo\"],\"ca_tranca_longa_lod1\":[\"cabelo_lod\"]}'",
  "copiar <saida>/lig_*/*.glb e ligacao_*.json para assets_v3/personagens; <saida>/espada/*.glb, tx_*.png e espada_longa.json para assets_v3/equipamentos",
  "godot --headless --path . --import   # recria os *_0.png extraídos e os .import",
  "testes: ferramentas/v3/testar_animacoes.py, testar_bainha.py; cena testes/prototipos/marco1_correcoes.tscn"
 ],
